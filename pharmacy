#include<stdio.h>
int main()
{
    int choice,medicineId,price,quantity;
    char medicineName[50];
    printf("Choose your  option:\n");
    printf("1.Create medicine module \n");
    printf("2.Update medicine module \n");
    printf("3.List  medicine module \n");
    printf("4.Delete medicine module \n");
    scanf("%d", &choice);
    switch(choice)
    {
        case 1:
            printf("\nCreate Medicine\n");

            printf("Enter Medicine ID: ");
            scanf("%d", &medicineId);

            printf("Enter Medicine Name: ");
            scanf("%s", medicineName);

            printf("Enter Medicine Price: ");
            scanf("%f", &price);

            printf("Enter Medicine Quantity: ");
            scanf("%d", &quantity);

            printf("\nMedicine created successfully!\n");
            printf("Medicine ID: %d\n", medicineId);
            printf("Medicine Name: %s\n", medicineName);
            printf("Medicine Price: %.2f\n", price);
            printf("Medicine Quantity: %d\n", quantity);
            break;
        case 2:
            printf("\nUpdate Medicine\n");
            break;
        case 3:
            printf("\nList Medicines\n");
            break;
        case 4:
            printf("\nDelete Medicine\n");
            break;
        default:
            printf("Invalid choice.\n");
    }

    return 0;
}
