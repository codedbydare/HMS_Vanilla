#include <stdio.h>

int main()
{
    int choice, medicineId, quantity;
    float price;
    char medicineName[50];
    FILE *file;

    printf("Choose your option:\n");
    printf("1. Create medicine module\n");
    printf("2. Update medicine module\n");
    printf("3. List medicine module\n");
    printf("4. Delete medicine module\n");

    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            printf("\nCreate Medicine\n");

            printf("Enter Medicine ID: ");
            scanf("%d", &medicineId);

            printf("Enter Medicine Name: ");
            scanf("%s", medicineName);

            printf("Enter Medicine Price: ");
            scanf("%f", &price);

            printf("Enter Medicine Quantity: ");
            scanf("%d", &quantity);

            file = fopen("medicine.txt", "a");

            fprintf(file, "%d %s %.2f %d\n",
                    medicineId, medicineName, price, quantity);

            fclose(file);

            printf("\nMedicine created successfully!\n");
            break;

        case 2:
            printf("\nUpdate Medicine\n");

            printf("Enter Medicine ID: ");
            scanf("%d", &medicineId);

            printf("Enter New Medicine Name: ");
            scanf("%s", medicineName);

            printf("Enter New Medicine Price: ");
            scanf("%f", &price);

            printf("Enter New Medicine Quantity: ");
            scanf("%d", &quantity);

            file = fopen("medicine.txt", "a");

            fprintf(file, "%d %s %.2f %d\n",
                    medicineId, medicineName, price, quantity);

            fclose(file);

            printf("\nMedicine updated successfully!\n");
            break;

        case 3:
            printf("\nList Medicines\n");

            file = fopen("medicine.txt", "r");

            if(file == NULL)
            {
                printf("No medicine data found.\n");
            }
            else
            {
                while(fscanf(file, "%d %s %f %d",
                             &medicineId,
                             medicineName,
                             &price,
                             &quantity) != EOF)
                {
                    printf("\nMedicine ID: %d", medicineId);
                    printf("\nMedicine Name: %s", medicineName);
                    printf("\nMedicine Price: %.2f", price);
                    printf("\nMedicine Quantity: %d\n", quantity);
                }

                fclose(file);
            }

            break;

        case 4:
            printf("\nDelete Medicine\n");

            printf("Enter Medicine ID: ");
            scanf("%d", &medicineId);

            printf("Delete operation selected for Medicine ID: %d\n",
                   medicineId);

            break;

        default:
            printf("Invalid choice.\n");
    }

    return 0;
}